# Publicación ligera: solo estas entradas de la raíz se versionan.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/ESTRUCTURA_REPOSITORIO.md
!/AGENTS.md
!/requirements.txt
!/src/
!/scripts/
!/tests/
!/configs/
!/splits/
!/metadata/
!/docs/
!/results/

# Entornos, secretos, pesos y datos binarios.
.venv*/
__pycache__/
*.py[cod]
.pytest_cache/
.env
.env.*
*.pem
*.key
*.p12
*.pt
*.pth
*.ckpt
*.safetensors
*.h5
*.hdf5
*.tif
*.tiff
*.npz
*.npy
*.zip
*.tar
*.gz
*.7z
*.png
*.jpg
*.jpeg

# Particiones admitidas y baseline L4S; propuestas duplicadas locales.
/splits/proposed/
/splits/provisional/
/metadata/integrated_provisional.csv

# Documentación técnica; borradores y acceso al servidor quedan locales.
/docs/*
!/docs/REPRODUCIBILIDAD.md
!/docs/datasets/
!/docs/preprocessing.md
!/docs/evaluation_protocol.md
!/docs/experimental_protocol.md
!/docs/weak_pipeline.md
!/docs/training.md
/docs/datasets/*
!/docs/datasets/*.md

# Solo reportes seleccionados; salidas de entrenamiento fuera de Git.
/results/*
!/results/audits/
!/results/analysis/
/results/analysis/*
!/results/analysis/l4s_roy_14_v1_test_seed42_user_report/
/results/audits/*
!/results/audits/*.json
!/results/audits/l4s_traindata_inspection/
!/results/audits/l4s_validdata_inspection/
!/results/audits/l4s_testdata_inspection/
!/results/audits/roy_inspection/
!/results/audits/roy_integration_review_v1/
!/results/audits/roy14_reconstruction_v1/
!/results/audits/roy_band_identity_v1/
!/results/audits/roy_ee_probe_v1/
!/results/audits/roy_ee_probe_point_0021_v1/
!/results/audits/roy_ee_probe_point_0002_v1/
!/results/audits/roy_ee_probe_point_0023_v1/
!/results/audits/roy_ee_probe_point_0502_v1/
!/results/audits/roy_ee_probe_comparison_v1/
!/results/audits/roy_topography_probe_v1/
!/results/audits/roy_topography_comparison_v1/
!/results/audits/roy_repository_review/
/results/audits/roy_repository_review/*
!/results/audits/roy_repository_review/README.md
!/results/audits/roy_repository_review/validation_join.csv
